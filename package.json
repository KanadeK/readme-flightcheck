{
  "name": "readme-flightcheck",
  "version": "0.1.0",
  "description": "Preflight README install commands, links, screenshots, examples, and first-screen information.",
  "type": "module",
  "license": "MIT",
  "author": "KanadeK",
  "bin": {
    "readme-flightcheck": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "action.yml",
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanadeK/readme-flightcheck.git"
  },
  "bugs": {
    "url": "https://github.com/KanadeK/readme-flightcheck/issues"
  },
  "homepage": "https://github.com/KanadeK/readme-flightcheck#readme",
  "keywords": [
    "readme",
    "documentation",
    "github-action",
    "devtools",
    "quality"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "dev": "npm run build && node dist/cli.js",
    "demo": "npm run build && node scripts/demo.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "prepack": "npm run build",
    "package": "npm run build && npm run demo && node scripts/package_release.mjs",
    "release-check": "node scripts/release_check.mjs",
    "security:scan": "node scripts/security_scan.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "archiver": "8.0.0",
    "commander": "15.0.0",
    "github-slugger": "2.0.0",
    "marked": "18.0.7",
    "mdast-util-to-string": "4.0.0",
    "picocolors": "1.1.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/archiver": "8.0.0",
    "@types/node": "26.6.1",
    "@types/pixelmatch": "7.1.0",
    "@types/pngjs": "6.0.5",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
